{
  "name": "hanzi-workshop",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,magenta \"npm:api\" \"ng serve --open\"",
    "api": "tsx watch --env-file-if-exists=.env.local --clear-screen=false server/server.ts",
    "build": "ng build && node scripts/write-config.mjs && npm run build:server",
    "app": "npm run build && node --env-file-if-exists=.env.local dist/server/server.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p server/tsconfig.json",
    "add-components": "tsx scripts/add-missing-components.ts",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/server.mjs \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --log-level=warning",
    "db:import": "tsx --env-file-if-exists=.env.local scripts/db-import.ts",
    "db:export": "tsx --env-file-if-exists=.env.local scripts/db-export.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait",
    "db:sql": "docker compose exec db mariadb -u hanzi -phanzi hanzi"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "hanzi-writer": "^3.7.3",
    "mysql2": "^3.24.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
