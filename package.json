{
  "name": "hanzi-workshop",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,magenta \"npm:api\" \"ng serve --open\"",
    "api": "tsx watch --clear-screen=false server/server.ts",
    "build": "ng build && npm run build:server",
    "app": "npm run build && node dist/server/server.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p server/tsconfig.json",
    "add-components": "tsx scripts/add-missing-components.ts",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/server.mjs --log-level=warning"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "hanzi-writer": "^3.7.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
