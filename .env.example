# Copy to .env.local (not committed) to use the local MariaDB from docker-compose.yml with
# "npm start", "npm run app" and "npm run db:import". The server needs DATABASE_URL.
DATABASE_URL=mysql://hanzi:hanzi@127.0.0.1:3307/hanzi
# OWNER_EMAIL=you@example.com   # your account takes over the imported lists (README: Accounts)

# Contact form and bug reports (About page): also sent by email when SMTP_HOST is set.
# With a Hostinger mailbox: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_USER=the mailbox.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@grolltech.be
# SMTP_PASS=the mailbox password
# FEEDBACK_TO=contact@grolltech.be   # where the messages go (default: SMTP_USER)
